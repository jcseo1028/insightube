# === LLM Provider 설정 (둘 중 하나만 설정) ===
# 방법 1: GitHub Token (GitHub Models 사용 — 별도 API 키 불필요)
GITHUB_TOKEN=your-github-token-here

# 방법 2: OpenAI API Key (OpenAI 직접 사용)
# OPENAI_API_KEY=your-openai-api-key-here

# === 공통 설정 ===
LLM_MODEL=gpt-4o-mini
MAX_TRANSCRIPT_LENGTH=50000
SUMMARY_LANGUAGE=ko

# === Notion 독서 DB 연동 (오늘의 독서 내용 기능) ===
# Notion Integration secret. https://www.notion.so/profile/integrations 에서 발급
NOTION_API_KEY=your-notion-secret-here
# 대상 독서 DB ID (URL의 32자리 문자열)
NOTION_READING_DB_ID=your-notion-database-id-here
# 완료 판별용 date 속성명 (기본: '읽기 종료')
NOTION_READING_DONE_PROPERTY=읽기 종료
