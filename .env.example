# === LLM Provider 설정 (하나만 설정) ===
# 감지 우선순위: ANTHROPIC → OPENAI → GITHUB

# 방법 1 (권장): Anthropic API Key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 방법 2: OpenAI API Key — https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here

# 방법 3: GitHub Token — [DEPRECATED] GitHub Models는 2026-07-30 은퇴되었습니다.
# GITHUB_TOKEN=your-github-token-here

# === 공통 설정 ===
# LLM_MODEL 미지정 시 프로바이더별 기본값 사용:
#   - Anthropic: claude-sonnet-4-5
#   - OpenAI/GitHub: gpt-4o-mini
LLM_MODEL=claude-sonnet-4-5
MAX_TRANSCRIPT_LENGTH=50000
SUMMARY_LANGUAGE=ko

# === Notion 독서 DB 연동 (오늘의 독서 내용 기능) ===
# Notion Integration secret. https://www.notion.so/profile/integrations 에서 발급
NOTION_API_KEY=your-notion-secret-here
# 대상 독서 DB ID (URL의 32자리 문자열)
NOTION_READING_DB_ID=your-notion-database-id-here
# 완료 판별용 date 속성명 (기본: '읽기 종료')
NOTION_READING_DONE_PROPERTY=읽기 종료
